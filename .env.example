# Скопіюйте у .env і заповніть. Файл .env НЕ комітиться в git.

NODE_ENV=development
# У розробці 5001 (frontend/package.json proxy). На хостингу PORT зазвичай задається автоматично.
PORT=5001

# MongoDB Atlas: окремий користувач БД з правами лише на цю базу,
# у Network Access — тільки IP сервера (не 0.0.0.0/0, якщо хостинг дає статичний IP).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/plumbingstore?retryWrites=true&w=majority

# Мінімум 32 символи. Згенерувати:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Публічна адреса сайту — використовується в посиланнях для скидання пароля
CLIENT_URL=http://localhost:3000

PAGINATION_LIMIT=8

# SMTP для листів (скидання пароля)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_NAME=Сантех Студія
FROM_EMAIL=

# Куди надсилати сповіщення про нові замовлення (email менеджера)
ORDER_NOTIFY_EMAIL=

# Кількість reverse proxy перед сервером (Render/Railway/Heroku/Nginx = 1).
# Якщо Node слухає інтернет напряму — 0. За замовчуванням: 1 у production, 0 у розробці.
# TRUST_PROXY=1

# Каталог для зображень з адмінки. На хостингах з ефемерним диском
# вкажіть шлях до постійного диска (наприклад /var/data/uploads).
# UPLOADS_DIR=uploads

# Лише якщо фронтенд розміщено на іншому домені (через кому)
# CORS_ORIGIN=https://example.com

# Акаунт адміністратора для першого запуску сідера (npm run data:import)
SEED_ADMIN_EMAIL=admin@santexstudio.ua
SEED_ADMIN_PASSWORD=
